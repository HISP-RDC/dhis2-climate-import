# OCS-to-DHIS2 pipeline template. Copy this file to import-pipeline.yaml and
# replace the sample DHIS2 Data Set and Data Element codes with identifiers
# available on the target instance. Secrets must remain in .env.

dhis2:
  org_unit_level: 3
  climate_data_set: CCH_WEEKLY
  climate_data_sets:
    - CCH_WEEKLY
  cache_max_age_hours: 168
  page_size: 500
  chunk_size: 1000
  async_threshold: 1000
  import_strategy: CREATE_AND_UPDATE
  preheat_cache: true
  trigger_analytics: false

open_climate_service:
  aggregate_process_id: aggregate_to_dhis2_json
  publish: true

imports:
  - id: precipitation_weekly_chirps
    label: Precipitation (CHIRPS)
    dataset_id: chirps3_precipitation_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_PRECIPITATION_CHIRPS
    period_type: week
    method: mean
    expected_units: mm

  - id: precipitation_weekly_era5_land
    label: Precipitation (ERA5-Land)
    dataset_id: era5land_precipitation_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_PRECIPITATION_ERA5_LAND
    period_type: week
    method: mean
    expected_units: mm

  - id: temperature_mean_weekly_era5_land
    label: Mean air temperature (ERA5-Land)
    dataset_id: era5land_temperature_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_TEMPERATURE_MEAN_ERA5_LAND
    period_type: week
    method: mean
    expected_units: degC

  - id: temperature_max_weekly_era5_land
    label: Maximum air temperature (ERA5-Land)
    dataset_id: era5land_temperature_max_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_TEMPERATURE_MAX_ERA5_LAND
    period_type: week
    method: mean
    expected_units: degC

  - id: temperature_min_weekly_era5_land
    label: Minimum air temperature (ERA5-Land)
    dataset_id: era5land_temperature_min_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_TEMPERATURE_MIN_ERA5_LAND
    period_type: week
    method: mean
    expected_units: degC

  - id: dewpoint_temperature_weekly_era5_land
    label: Dewpoint temperature (ERA5-Land)
    dataset_id: era5land_dewpoint_temperature_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_DEWPOINT_TEMPERATURE_ERA5_LAND
    period_type: week
    method: mean
    expected_units: degC

  - id: relative_humidity_weekly_era5_land
    label: Relative humidity (ERA5-Land)
    dataset_id: era5land_relative_humidity_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_RELATIVE_HUMIDITY_ERA5_LAND
    period_type: week
    method: mean
    expected_units: "%"

  - id: heat_stress_weekly_era5_heat
    label: Mean heat stress (ERA5-HEAT UTCI)
    dataset_id: era5heat_utci_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_HEAT_STRESS_MEAN_ERA5_HEAT
    period_type: week
    method: mean
    expected_units: degC

  - id: heat_stress_max_weekly_era5_heat
    label: Maximum heat stress (ERA5-HEAT UTCI)
    dataset_id: era5heat_utci_max_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_HEAT_STRESS_MAX_ERA5_HEAT
    period_type: week
    method: mean
    expected_units: degC

  - id: heat_stress_min_weekly_era5_heat
    label: Minimum heat stress (ERA5-HEAT UTCI)
    dataset_id: era5heat_utci_min_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_HEAT_STRESS_MIN_ERA5_HEAT
    period_type: week
    method: mean
    expected_units: degC

  - id: vegetation_ndvi_weekly
    label: Normalized Difference Vegetation Index (MODIS)
    dataset_id: modis_ndvi_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_VEGETATION_NDVI_MODIS
    period_type: week
    method: mean
    expected_units: "1"

  - id: vegetation_evi_weekly
    label: Enhanced Vegetation Index (MODIS)
    dataset_id: modis_evi_weekly
    data_set: CCH_WEEKLY
    data_element: CCH_VEGETATION_EVI_MODIS
    period_type: week
    method: mean
    expected_units: "1"
