schema_version: 2
id: dhis2-x-to-y

source:
  instance: x

target:
  instance: y
  metadata:
    # If the target Data Set is absent, validate and import the official
    # DHIS2 dependency package before importing data values.
    mode: create_if_missing
    identity_strategy: preserve_uid
    # Enable only after a read-only audit of partial metadata on the target.
    # Repairs remain an explicit repair-metadata --apply operation.
    reconcile_existing: false
    skip_sharing: true
    import:
      strategy: CREATE
      atomic: true
    synchronization:
      enabled: true
      create_missing_objects: true
      attach_compatible_data_elements: true
      incompatible:
        policy: safe_repair
        require_no_data_values: true
        require_no_other_dataset_memberships: true
        require_same_identity: true
      historical_data_elements:
        enabled: true
        strategy: versioned
        # "block" is the conservative default. "clone" preserves an incompatible
        # object on Y and creates an isolated historical category graph instead.
        uid_collision_strategy: clone
        name_suffix: " — Historique"

  organisation_units:
    # Uses the organisation units assigned to the source Data Set. Use
    # configured_roots/source_roots when a hierarchy root is more appropriate.
    discovery: linked_to_dataset
    mapping_strategy: uid
    include_children: false
    batch_size: 40
    synchronization:
      # Keep disabled until the generated hierarchy plan has been reviewed.
      enabled: false
      # Once the manual dry-run has been approved, this can guard every transfer.
      run_before_transfer: false
      # block is the safe default. With exclude, detected identity/parent conflicts
      # quarantine only their selected source subtrees and remain fully audited.
      # exclude requires enabled=true, run_before_transfer=true and UID mapping.
      conflict_policy: block
      create_missing: true
      require_same_name: true
      # Set false only when Y intentionally uses a different code convention.
      # UID collisions and parent differences remain blocking in all cases.
      require_same_code: true
      allow_root_creation: false
      attach_to_target_data_set: true
      preserve_geometry: true

mapping:
  data_elements: uid
  organisation_units: uid
  category_option_combos: uid
  attribute_option_combos: uid
  data_sets: uid

transfer:
  import_strategy: CREATE_AND_UPDATE
  chunk_size: 5000
  # Number of DHIS2 periods per source request. Defaults are 31 daily,
  # 13 weekly, 1 monthly, and 1 yearly period when omitted.
  source_period_batch_size: 13
  preheat_cache: true
  include_deleted: false
  preserve_comments: true
  retry:
    attempts: 5
    initial_delay_seconds: 5
    max_delay_seconds: 120
  execution:
    # period_batch_size defaults to 31 days, 13 weeks, 3 months or 1 year
    # and may be overridden per job.
    process_isolation: true
    resume: true
    stop_on_error: true

execution:
  max_parallel_jobs: 1

state:
  directory: state

jobs:
  - id: weekly_climate
    source_data_set: CCH_CLIMATE_WEATHER
    target_data_set: CCH_CLIMATE_WEATHER
    period_type: week
    default_start_period: 2026-W01
    default_end_period: 2026-W40
    data_elements:
      discovery: linked_to_dataset
    # Optional manual per-job quarantine in addition to conflict_policy. Each UID
    # must be a selected source OU or one of its ancestors.
    # organisation_units:
    #   exclude:
    #     - uid: BlockedOu01
    #       reason: "Temporary review: source and target parents differ"
