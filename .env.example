# DHIS2 target instance. Use a non-production instance for v1 validation.
DHIS2_BASE_URL=https://dhis2.example.org

# auto prefers DHIS2_PAT when set, otherwise Basic Auth.
# Use basic if the instance/proxy rejects PAT authentication.
DHIS2_AUTH_METHOD=auto

# dhis2-client uses the official dhis2-python-client package.
# stdlib keeps the tiny built-in urllib transport as an emergency fallback.
DHIS2_TRANSPORT=dhis2-client
DHIS2_CLIENT_LOG_LEVEL=CRITICAL
# Read timeout used for both transfer instances. Adaptive chunking handles an
# occasional timeout; 120 seconds also lets the proxy return its own status.
DHIS2_TIMEOUT_SECONDS=120
DHIS2_CONNECT_TIMEOUT_SECONDS=30
DHIS2_RETRIES=3
DHIS2_PAT=

# Optional fallback when no PAT is available. Do not commit real credentials.
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Optional DHIS2-to-DHIS2 transfer profiles. The variable names are referenced
# by config/instances.yaml; PAT and Basic Auth can be mixed per instance.
DHIS2_X_BASE_URL=
DHIS2_X_USERNAME=
DHIS2_X_PASSWORD=
DHIS2_X_PAT=
DHIS2_Y_BASE_URL=
DHIS2_Y_USERNAME=
DHIS2_Y_PASSWORD=
DHIS2_Y_PAT=

# Open Climate Service instance used by this orchestrator.
CLIMATE_SERVICE_BASE_URL=http://127.0.0.1:9000
# Ingestions are submitted as native OCS background jobs. Only submission and
# status polling use the short HTTP timeout; the job itself may run for 24 hours.
CLIMATE_SERVICE_HTTP_TIMEOUT_SECONDS=60
CLIMATE_SERVICE_POLL_SECONDS=5
CLIMATE_SERVICE_JOB_TIMEOUT_SECONDS=86400

# Optional HTML email notifications emitted after every climate pipeline run.
# Keep real SMTP credentials and recipient lists only in the local .env file.
DHIS2_CLIMATE_EMAIL_ENABLED=false
DHIS2_CLIMATE_ADMIN_EMAIL_ON_SUCCESS=true
DHIS2_CLIMATE_ADMIN_EMAIL_ON_FAILURE=true
DHIS2_CLIMATE_ADMIN_EMAIL_TO=operations@example.org
# End users receive only successful or explicit test notifications. Their
# addresses are hidden from one another in the delivered message.
DHIS2_CLIMATE_USER_EMAIL_ON_SUCCESS=false
DHIS2_CLIMATE_USER_EMAIL_TO=user1@example.org,user2@example.org
DHIS2_CLIMATE_EMAIL_FROM=dhis2-climate@example.org

# HISP RDC email branding. The bundled logo is attached inline; no public image
# URL or path is required. Set a path only to override the bundled logo.
DHIS2_CLIMATE_EMAIL_BRAND_NAME=HISP RDC
DHIS2_CLIMATE_EMAIL_LOCALE=en
DHIS2_CLIMATE_EMAIL_LOGO_PATH=
DHIS2_CLIMATE_EMAIL_PRIMARY_COLOR=#1477E5
DHIS2_CLIMATE_EMAIL_NAVY_COLOR=#091B67
DHIS2_CLIMATE_EMAIL_ACCENT_COLOR=#F02B16
DHIS2_CLIMATE_EMAIL_GOLD_COLOR=#FFD500
DHIS2_CLIMATE_EMAIL_PORTAL_URL=
DHIS2_CLIMATE_EMAIL_SUPPORT_EMAIL=

DHIS2_CLIMATE_SMTP_HOST=smtp.example.org
DHIS2_CLIMATE_SMTP_PORT=587
# starttls (recommended on port 587), ssl (usually port 465), or none.
DHIS2_CLIMATE_SMTP_SECURITY=starttls
DHIS2_CLIMATE_SMTP_USERNAME=
DHIS2_CLIMATE_SMTP_PASSWORD=
DHIS2_CLIMATE_SMTP_TIMEOUT_SECONDS=30
