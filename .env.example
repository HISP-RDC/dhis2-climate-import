# DHIS2 target instance. Use a non-production instance for v1 validation.
DHIS2_BASE_URL=https://dhis2.example.org

# auto prefers DHIS2_PAT when set, otherwise Basic Auth.
# Use basic if the instance/proxy rejects PAT authentication.
DHIS2_AUTH_METHOD=auto

# dhis2-client uses the official dhis2-python-client package.
# stdlib keeps the tiny built-in urllib transport as an emergency fallback.
DHIS2_TRANSPORT=dhis2-client
DHIS2_CLIENT_LOG_LEVEL=CRITICAL
DHIS2_PAT=

# Optional fallback when no PAT is available. Do not commit real credentials.
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Open Climate Service instance used by this orchestrator.
CLIMATE_SERVICE_BASE_URL=http://127.0.0.1:8000
