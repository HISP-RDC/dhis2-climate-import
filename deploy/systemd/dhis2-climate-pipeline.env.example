# Jobs are executed from left to right. Keep them sequential because OCS uses
# one writable process and ERA5 downloads can be resource intensive.
DHIS2_CLIMATE_JOBS="temperature_mean_weekly_era5_land temperature_max_weekly_era5_land temperature_min_weekly_era5_land dewpoint_temperature_weekly_era5_land relative_humidity_weekly_era5_land heat_stress_weekly_era5_heat heat_stress_max_weekly_era5_heat heat_stress_min_weekly_era5_heat vegetation_ndvi_weekly vegetation_evi_weekly precipitation_weekly_chirps precipitation_weekly_era5_land"

# rolling: derive an ISO-week window whenever the service starts.
# fixed: use DHIS2_CLIMATE_START_PERIOD and DHIS2_CLIMATE_END_PERIOD below.
DHIS2_CLIMATE_WINDOW_MODE=rolling

# The rolling window ends three complete ISO weeks before the latest complete
# week and revisits eight weeks. Revisited values are idempotent updates and
# protect against late source publication or a missed timer execution.
DHIS2_CLIMATE_LOOKBACK_WEEKS=8
DHIS2_CLIMATE_LAG_WEEKS=3

# Split both OCS ingestion and DHIS2 dry-run/apply into bounded ISO-week
# windows. Thirteen weeks gives four independent windows per year. Each stage
# runs in a separate Python process, so its memory is released between stages.
DHIS2_CLIMATE_PERIOD_BATCH_SIZE=13

# Optional deterministic anchor (YYYY-MM-DD), mainly for controlled replays.
# Empty means the server's current date.
DHIS2_CLIMATE_AS_OF=

# Required only with DHIS2_CLIMATE_WINDOW_MODE=fixed.
# DHIS2_CLIMATE_START_PERIOD=2020-W01
# DHIS2_CLIMATE_END_PERIOD=2026-W39

# true: audit a failed source and continue with the next climate job.
# false: stop immediately on the first failed job.
DHIS2_CLIMATE_CONTINUE_ON_FAILURE=true

# Refresh the DHIS2 organisation-unit and Data Element caches before running.
DHIS2_CLIMATE_REFRESH_CACHES=true

# Climate values cannot be computed for an OU without geometry. When true,
# these OUs are excluded and recorded in the cache manifest instead of
# blocking every climate job.
DHIS2_CLIMATE_SKIP_MISSING_GEOMETRY=true
