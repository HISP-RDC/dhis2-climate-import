id: cod-climate-service
name: Democratic Republic of the Congo Climate Service

extent:
  name: Democratic Republic of the Congo
  bbox: [12.0, -13.5, 31.5, 5.4]
  country_code: COD

# Keep climate artifacts outside the Git checkout so a deployment cannot
# remove them. The directory must be writable by the service user.
data_dir: /var/lib/open-climate-service
plugins_dir: /opt/open-climate-service/plugins/

# Recurrence is controlled by dhis2-climate-pipeline.timer. Do not enable the
# OCS scheduler for the same datasets at the same time.
scheduler:
  enabled: false
