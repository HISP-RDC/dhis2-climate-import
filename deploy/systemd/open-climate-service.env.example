# Install as /opt/open-climate-service/.env with owner meleck and mode 0600.
CLIMATE_SERVICE_CONFIG=/opt/open-climate-service/climate-service.yaml

# Required by ERA5-Land daily statistics and ERA5-HEAT.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Optional acceleration for some ERA5-Land historical downloads.
# EDH_API_KEY=

# MODIS NDVI/EVI use Microsoft Planetary Computer and need no GEE key.
