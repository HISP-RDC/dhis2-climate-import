# Jobs executed from left to right. Keep hospital_service first when the queue
# must join an already running historical transfer before starting the others.
DHIS2_TRANSFER_JOBS="hospital_service sigl_fosa weekly_climate service_base relevant_epidemiological_data"

# true: audit the failure and continue with the next job.
# false: stop the queue at the first failed job.
DHIS2_TRANSFER_CONTINUE_ON_FAILURE=true

# Interval used to observe the current systemd job without busy-waiting.
DHIS2_TRANSFER_QUEUE_POLL_SECONDS=15
